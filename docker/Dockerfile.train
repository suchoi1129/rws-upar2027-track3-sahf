# Training: the ViTPose environment of requirements/train_freeze.txt (Python 3.8, PyTorch 1.9.0 + CUDA 11.1,
# mmcv-full 1.3.9), installed with uv as in README step 1. The CUDA runtime comes with the PyTorch wheels.
#   docker build -f docker/Dockerfile.train -t upar-sahf-train .
FROM ubuntu:20.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates build-essential git libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.11.29 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python UV_LINK_MODE=copy UV_NO_CACHE=1
WORKDIR /workspace/upar2027-track3-sahf
COPY . .
RUN IDX="--extra-index-url https://download.pytorch.org/whl/cu111 --index-strategy unsafe-best-match" \
    && uv venv -p 3.8 /opt/venv-train \
    && uv pip install -p /opt/venv-train/bin/python torch==1.9.0+cu111 torchvision==0.10.0+cu111 $IDX \
    && uv pip install -p /opt/venv-train/bin/python pip "setuptools<70" wheel numpy==1.23.5 \
    && uv pip install -p /opt/venv-train/bin/python --no-build-isolation -r requirements/train_freeze.txt $IDX
RUN chmod -R a+rwX /workspace                       # also runs with docker run --user
ENV PATH=/opt/venv-train/bin:$PATH
